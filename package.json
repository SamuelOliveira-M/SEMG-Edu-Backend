{
  "name": "semg-backend-node",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx prisma generate && tsc -p .",
    "start": "npm run build && node ./build/server.js",
    "dev": "node --env-file=.env.dev node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "dev:remote": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:db:up": "tsx scripts/local-db.ts",
    "test:db:down": "echo Pare o processo do npm run db:up (Ctrl+C); dados ficam em .pgdata",
    "db:up": "tsx scripts/local-db.ts",
    "db:migrate": "node --env-file=.env.dev node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.dev node_modules/tsx/dist/cli.mjs scripts/prepare-db.ts",
    "db:seed": "node --env-file=.env.dev node_modules/tsx/dist/cli.mjs scripts/seed-dev.ts",
    "db:studio": "node --env-file=.env.dev node_modules/prisma/build/index.js studio --port 5555 --browser none",
    "dev:local": "npm run dev"
  },
  "keywords": [],
  "author": "Samuel Oliveira de Moura",
  "license": "ISC",
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/bcryptjs": "^2.4.4",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.18",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^7.21.0",
    "prisma": "^7.7.0",
    "supertest": "^7.3.1",
    "tsx": "^3.12.10",
    "typescript": "^5.2.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.8.0",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/swagger-ui-express": "^4.1.4",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "blob-stream": "^0.1.3",
    "cors": "^2.8.5",
    "cpf-cnpj-validator": "^1.0.3",
    "dayjs": "^1.11.10",
    "dotenv": "^16.6.1",
    "esbuild": "^0.19.10",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "fetch-blob": "^4.0.0",
    "firebase-admin": "^12.0.0",
    "fs": "^0.0.1-security",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "npm": "^10.5.0",
    "path": "^0.12.7",
    "pg": "^8.18.0",
    "swagger-ui-express": "^5.0.0"
  }
}
