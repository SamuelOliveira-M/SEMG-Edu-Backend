{
  "info": {
    "name": "SEMG.Edu API",
    "description": "Gerada a partir de src/routes. Rode \"Login\" primeiro: o token e o refreshTokenId são salvos nas variáveis da coleção. Ajuste os ids ({{classId}}, {{teacherId}}...) conforme os dados criados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}",
                "description": "Token cru, sem \"Bearer\". Hoje nenhuma rota exige autenticação.",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gestor@semg.edu\",\n  \"senha\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.accessToken) pm.collectionVariables.set(\"token\", d.accessToken);",
                  "if (d.idRefreshToken) pm.collectionVariables.set(\"refreshTokenId\", d.idRefreshToken);",
                  "if (d.id) pm.collectionVariables.set(\"userId\", d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}",
                "description": "Token cru, sem \"Bearer\". Hoje nenhuma rota exige autenticação.",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/refreshtoken",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refreshtoken"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshTokenId\": \"{{refreshTokenId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
